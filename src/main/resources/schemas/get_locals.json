{
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Java source file or directory to verify."
      },
      "file": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Java source file in which to resolve the cursor position."
      },
      "line": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "column": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "path",
      "file",
      "line",
      "column"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "VERIFIER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "variables": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "internalName": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "refinement": {
              "type": "string"
            },
            "location": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "startColumn": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endColumn": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "file",
                "startLine",
                "startColumn",
                "endLine",
                "endColumn"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "internalName",
            "type",
            "refinement",
            "location"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "variables"
    ],
    "additionalProperties": false
  }
}
