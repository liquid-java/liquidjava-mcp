{
  "inputSchema": {
    "type": "object",
    "properties": {
      "variables": {
        "type": "object",
        "propertyNames": {
          "pattern": "^(?![A-Z][a-zA-Z0-9]*$)#*[a-zA-Z_][a-zA-Z0-9_#]*$",
          "not": {
            "enum": ["_", "this", "old", "true", "false", "int", "short", "char", "long", "double", "float", "boolean"]
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^(?:[a-zA-Z_$][a-zA-Z0-9_$]*\\.)*[a-zA-Z_$][a-zA-Z0-9_$]*$"
        }
      },
      "ghosts": {
        "type": "object",
        "description": "Uninterpreted ghost functions available to the predicates.",
        "propertyNames": {
          "pattern": "^(?![A-Z][a-zA-Z0-9]*$)#*[a-zA-Z_][a-zA-Z0-9_#]*$",
          "not": {"enum": ["_", "this", "old", "true", "false"]}
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "parameterTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[a-zA-Z_$][a-zA-Z0-9_$]*\\.)*[a-zA-Z_$][a-zA-Z0-9_$]*$"
              }
            },
            "returnType": {
              "type": "string",
              "pattern": "^(?:[a-zA-Z_$][a-zA-Z0-9_$]*\\.)*[a-zA-Z_$][a-zA-Z0-9_$]*$"
            }
          },
          "required": ["parameterTypes", "returnType"],
          "additionalProperties": false
        }
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "required": ["variables", "ghosts", "constraints"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "enum": ["sat", "unsat", "unknown"]
      },
      "assignment": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "variable": {"type": "string"},
            "value": {"type": "string"}
          },
          "required": ["variable", "value"],
          "additionalProperties": false
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {"enum": ["INVALID_INPUT", "VERIFIER_ERROR"]},
          "message": {"type": "string"}
        },
        "required": ["code", "message"],
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "oneOf": [
      {
        "properties": {"status": {"const": "sat"}},
        "required": ["status", "assignment"],
        "not": {"required": ["error"]}
      },
      {
        "properties": {"status": {"enum": ["unsat", "unknown"]}},
        "required": ["status"],
        "not": {"anyOf": [{"required": ["assignment"]}, {"required": ["error"]}]}
      },
      {
        "required": ["error"],
        "not": {"anyOf": [{"required": ["status"]}, {"required": ["assignment"]}]}
      }
    ]
  }
}
