{
  "inputSchema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "required": ["paths"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "output": {
        "type": "string"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["INVALID_INPUT", "VERIFIER_ERROR"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      }
    },
    "required": ["success", "output"],
    "additionalProperties": false
  }
}
