{
  "inputSchema": {
    "type": "object",
    "properties": {
      "debug": {
        "type": "boolean",
        "default": false,
        "description": "Include detailed LiquidJava debug information in output."
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Java source file or directory to verify."
      }
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "output": {
        "type": "string"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["INVALID_INPUT", "VERIFIER_ERROR"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      }
    },
    "required": ["success", "output"],
    "additionalProperties": false
  }
}
