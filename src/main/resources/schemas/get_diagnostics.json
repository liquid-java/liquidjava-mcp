{
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Java source file or directory to verify."
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "VERIFIER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "errors": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/diagnostic"
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/diagnostic"
        }
      }
    },
    "required": [
      "success",
      "errors",
      "warnings"
    ],
    "additionalProperties": false,
    "$defs": {
      "diagnostic": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "declarationLocation": {
            "$ref": "#/$defs/location"
          },
          "hint": {
            "type": "string"
          },
          "customMessage": {
            "type": "string"
          },
          "refinements": {
            "type": "object",
            "properties": {
              "refinement": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "found": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "vc": {
            "type": "object",
            "properties": {
              "expected": {
                "type": "string"
              },
              "history": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "implication": {
                      "type": "string"
                    },
                    "simplification": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "implication"
                  ],
                  "additionalProperties": false
                }
              },
              "found": {
                "type": "string",
                "description": "Final simplified antecedent implication chain."
              }
            },
            "required": [
              "expected",
              "found",
              "history"
            ],
            "additionalProperties": false
          },
          "counterexample": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variable": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "variable",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "variable",
                      "ghost",
                      "alias",
                      "constant"
                    ]
                  }
                },
                "required": [
                  "name",
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "className": {
                    "type": "string"
                  }
                },
                "required": [
                  "className"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "className": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "overloads": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "className",
                  "signature",
                  "overloads"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "type",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "location": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "startLine": {
            "type": "integer",
            "minimum": 1
          },
          "startColumn": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "endColumn": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "file",
          "startLine",
          "startColumn",
          "endLine",
          "endColumn"
        ],
        "additionalProperties": false
      }
    }
  }
}
