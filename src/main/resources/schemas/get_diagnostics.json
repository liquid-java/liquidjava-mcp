{
  "inputSchema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "required": [
      "paths"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "VERIFIER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "errors": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/diagnostic"
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/diagnostic"
        }
      }
    },
    "required": [
      "success",
      "errors",
      "warnings"
    ],
    "additionalProperties": false,
    "$defs": {
      "diagnostic": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "startColumn": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "endColumn": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "file",
              "startLine",
              "startColumn",
              "endLine",
              "endColumn"
            ],
            "additionalProperties": false
          },
          "declarationLocation": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "startColumn": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "endColumn": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "file",
              "startLine",
              "startColumn",
              "endLine",
              "endColumn"
            ],
            "additionalProperties": false
          },
          "hint": {
            "type": "string"
          },
          "customMessage": {
            "type": "string"
          },
          "refinements": {
            "type": "object",
            "properties": {
              "expected": {
                "type": "string"
              },
              "found": {
                "type": "string"
              },
              "refinement": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "vc": {
            "type": "object",
            "properties": {
              "simplified": {
                "type": "string"
              },
              "original": {
                "type": "string"
              }
            },
            "required": [
              "simplified",
              "original"
            ],
            "additionalProperties": false
          },
          "counterexample": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variable": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "variable",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  }
}
